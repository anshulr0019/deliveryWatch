# --- Database (PostgreSQL via Drizzle) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Monitoring cron (Vercel Cron sends `Authorization: Bearer $CRON_SECRET`) ---
CRON_SECRET=your-random-cron-secret

# --- Email alerts (Resend) ---
RESEND_API_KEY=re_...
ALERT_FROM_EMAIL="DeliveryWatch <alerts@yourdomain.com>"

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# Enable only behind a proxy that overwrites X-Forwarded-For. Vercel is detected automatically.
TRUST_PROXY=false
